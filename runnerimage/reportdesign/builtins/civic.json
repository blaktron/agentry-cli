    "banded": false
  },
  "quotes": "callout",
  "brand": {
    "name": "",
    "strapline": "",
    "contact": [],
    "website": "",
    "confidentiality": ""
  },
  "header": {
    "style": "brandLine",
    "slots": [
      "{brand}",
      "",
      "{date}"
    ]
  },
  "footer": {
    "pageNumbers": "nOfN",
    "slots": [
      "{brand}",
      "{confidentiality}",
      ""
    ]
  },
  "cover": {
    "style": "framed",
    "shows": [
      "title",
      "subtitle",
      "author",
      "date",
      "brand",
      "confidentiality"
