{
  "agentryTheme": 3,
  "name": "Civic",
  "basedOn": "civic",
  "version": 1,
  "paper": "a4",
  "fonts": {
    "headings": "Crimson Pro",
    "body": "Crimson Pro",
    "code": "IBM Plex Mono"
  },
  "accent": "#6e1d2e",
  "secondary": "#6d675f",
  "titleBlock": "ruled",
  "headings": "numbered",
  "headingScale": "regular",
  "margins": "wide",
  "tables": {
