{
  "planVersion": "2",
  "ref": "demo/full-caps@2.1.0",
  "digest": "sha256:0123456789abcdef",
  "source": "local",
  "modes": [
    "autonomous",
    "interactive"
  ],
  "mode": "autonomous",
  "summary": "Exercises every capability shape",
  "policySha256": "fixedpolicysha",
  "instruction": {
    "sourcePath": "SKILL.md",
    "sha256": "57f5ea271386e95bc2232ebdb5b4df7cc56bfa5689a0b0e36ae1730f5b3d4d11"
  },
  "capabilities": {
    "egressMode": "hosts",
    "egressHosts": [
      "api.example.com",
      "api.other.net"
    ],
    "fsReadMode": "workspace",
    "fsWriteMode": "paths",
    "fsWritePaths": [
      "notes/summary.md",
      "reports"
    ],
    "execCommands": [
      "git",
      "jq"
    ],
    "dataAccess": [
      "tickets"
    ]
  },
  "tools": [
    "fs_read",
    "fs_list",
    "fs_write",
    "fetch",
    "run_command",
    "list_inputs",
    "read_input",
    "write_report"
  ],
  "enforcement": {
    "agentContainer": "internal-only run network; reachable endpoints: gateway:8811 (Bearer auth) and llm-proxy:3128 (CONNECT allowlist: api.anthropic.com:443); no workspace, output, or docker-socket mounts; model API key present by necessity",
    "dataAccess": "declared tickets; no servers cataloged by policy (declaration recorded for audit)",
    "exec": "run_command restricted to argv0 allowlist + shim PATH {git, jq}; tools container is the runner image with the operator's catalogued packages installed (git ← apk git, jq ← apk jq) and minimized to exactly those binaries (per-BriefAgent exec image, agentry-cli#9, #100); git: safe.directory covers the run's workspace and inputs mounts in the image's /etc/gitconfig, so a bind mount owned by the host user is not refused as dubiously owned",
    "filesystem": "read workspace; write paths {notes/summary.md, reports} — enforced by the tools-container mount table (ro/rw, per-path binds) plus server-side grant checks",
    "model.apiKey": "$ANTHROPIC_API_KEY from the host environment, injected into the agent container (or the host harness process) only",
    "network": "egress pinned to declared hosts via gateway per-server proxies + DNS interception (--block-network) and re-checked per request/redirect hop by the fetch tool: api.example.com, api.other.net",
    "runtime": "runsc: the run's containers are created with docker --runtime runsc where it holds; the receipt's runtime line names each container class, and each that takes the daemon's default and why",
    "secrets": "values resolved at run start (missing ⇒ refuse, exit 11), injected only into the tools container via gateway secret scoping, absent from plan and receipts: EXAMPLE_TOKEN"
  },
  "gateway": {
    "image": "ghcr.io/blaktron/agentry-mcp-gateway:v0.43.3",
    "args": [
      "--transport",
      "streaming",
      "--port",
      "8811",
      "--servers",
      "agentry-tools",
      "--catalog",
      "/root/.docker/mcp/catalogs/catalog.yaml",
      "--registry",
      "/root/.docker/mcp/catalogs/registry.yaml",
      "--config",
      "/root/.docker/mcp/catalogs/config.yaml",
      "--tools-config",
      "/root/.docker/mcp/catalogs/tools.yaml",
      "--secrets",
      "/root/.docker/mcp/catalogs/secrets.env",
      "--block-network",
      "--verify-signatures",
      "--log-calls",
      "--block-secrets"
    ],
    "env": [
      {
        "name": "MCP_GATEWAY_AUTH_TOKEN",
        "fromRunToken": true
      },
      {
        "name": "HOME",
        "value": "/root"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOWED_PATHS",
        "value": "@@RUN_WORKSPACE@@:@@RUN_OUT@@:@@RUN_CFG@@:@@RUN_INPUTS@@:@@RUN_KNOWLEDGE@@"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOW_WRITABLE_PATHS",
        "value": "@@RUN_OUT@@:@@RUN_WORKSPACE@@"
      }
    ],
    "mounts": [
      {
        "source": "@@RUN_CFG@@/gateway",
        "target": "/root/.docker/mcp/catalogs",
        "readOnly": true
      },
      {
        "source": "/var/run/docker.sock",
        "target": "/var/run/docker.sock"
      }
    ],
    "servers": [
      "agentry-tools"
    ]
  },
  "execImage": {
    "tag": "agentry-runner-exec:test-17262807b507",
    "commands": [
      "git",
      "jq"
    ],
    "packages": [
      "git",
      "jq"
    ]
  },
  "harness": {
    "adapter": "docker-agent",
    "model": "anthropic/claude-sonnet-4-5",
    "agent": {
      "image": "ghcr.io/blaktron/agentry-docker-agent:1.128.0",
      "argv": [
        "run",
        "--exec",
        "--json",
        "--safety",
        "autonomous",
        "/plan/agent.yaml",
        "-"
      ],
      "env": [
        {
          "name": "MCP_GATEWAY_TOKEN",
          "fromRunToken": true
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "fromHostEnv": "ANTHROPIC_API_KEY",
          "expectedKind": {
            "provider": "anthropic",
            "kind": "api"
          }
        },
        {
          "name": "HTTPS_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "HTTP_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "NO_PROXY",
          "value": "gateway,localhost,127.0.0.1"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "mounts": [
        {
          "source": "@@RUN_CFG@@/harness",
          "target": "/plan",
          "readOnly": true
        }
      ],
      "stdinTask": true,
      "readOnlyRoot": true,
      "tmpfs": [
        "/tmp:mode=1777",
        "/work:mode=1777",
        "/home/docker-agent:mode=1777"
      ]
    },
    "resultKind": "text"
  },
  "proxy": {
    "image": "agentry-runner:test",
    "allow": [
      "api.anthropic.com:443"
    ]
  },
  "docker": {
    "runtime": "runsc"
  },
  "secrets": [
    "EXAMPLE_TOKEN"
  ],
  "budgets": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
