{
  "specVersion": "16",
  "workspaceDir": "/workspace",
  "outDir": "/out",
  "inputsDir": "/inputs",
  "inputsTextDir": "/inputs-text",
  "scratchDir": "/scratch",
  "fsRead": {
    "enabled": true
  },
  "fsWrite": {
    "enabled": true,
    "paths": [
      "notes/summary.md",
      "reports"
    ]
  },
  "fetch": {
    "enabled": true,
    "hosts": [
      "api.example.com",
      "api.other.net"
    ],
    "allowAll": false,
    "secretEnv": [
      "EXAMPLE_TOKEN"
    ]
  },
  "exec": {
    "commands": [
      "git",
      "jq"
    ]
  },
  "pdf": {
    "enabled": true
  },
  "search": {
    "enabled": true
  },
  "limits": {
    "maxResultBytes": 49152,
    "maxResultLines": 1900
  }
}
