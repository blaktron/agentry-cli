    "gateway/tools.yaml": "6bd0c945d5d1da659f3ebfd2f6e4ac20e775c10e15a06f957876cfac8a0f1a80",
    "gateway/toolspec.json": "1ef45564246f718688bb4647068c32639c79c12f99d38b8aaf6cf13a8e38edcd",
    "harness/agent.yaml": "33589da913ec32d9f0606bb00f1d5e92c06a39bd8a0bd8e158265dec35823e9f"
  }
}
