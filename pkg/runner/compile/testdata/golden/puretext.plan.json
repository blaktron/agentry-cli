{
  "planVersion": "2",
  "ref": "demo/pure-text@1.0.0",
  "digest": "sha256:0123456789abcdef",
  "source": "local",
  "modes": [
    "autonomous"
  ],
  "mode": "autonomous",
  "summary": "A pure text agent",
  "policySha256": "fixedpolicysha",
  "instruction": {
    "sourcePath": "AGENT.md",
    "sha256": "619a4198ce15bd08255bfd2b404a09471dffe9798c3d3c7d430135d5a50129f3",
    "bodySha256": "ea04f9c2aced19c2b7daccfaf1beb2b5fd5e4301a18ecd1a922bf738ffd87b9a"
  },
  "capabilities": {
    "egressMode": "none",
    "fsReadMode": "none",
    "fsWriteMode": "none"
  },
  "tools": [
    "list_inputs",
    "read_input",
    "search_inputs",
    "write_report"
  ],
  "enforcement": {
    "agentContainer": "internal-only run network; reachable endpoints: gateway:8811 (Bearer auth) and llm-proxy:3128 (CONNECT allowlist: api.anthropic.com:443); no workspace, output, or docker-socket mounts; model API key present by necessity",
    "exec": "no exec: run_command tool not exposed; harness built-in shell toolsets never enabled",
    "filesystem": "read none; write none — enforced by the tools-container mount table (ro/rw, per-path binds) plus server-side grant checks",
    "model.apiKey": "$ANTHROPIC_API_KEY from the host environment, injected into the agent container (or the host harness process) only",
    "network": "no egress: tools container runs with networking disabled (disableNetwork); no fetch tool exposed",
    "secrets": "none declared"
  },
  "gateway": {
    "image": "ghcr.io/blaktron/agentry-mcp-gateway:v0.43.3",
    "args": [
      "--transport",
      "streaming",
      "--port",
      "8811",
      "--servers",
      "agentry-tools",
      "--catalog",
      "/root/.docker/mcp/catalogs/catalog.yaml",
      "--registry",
      "/root/.docker/mcp/catalogs/registry.yaml",
      "--config",
      "/root/.docker/mcp/catalogs/config.yaml",
      "--tools-config",
      "/root/.docker/mcp/catalogs/tools.yaml",
      "--secrets",
      "/root/.docker/mcp/catalogs/secrets.env",
      "--block-network",
      "--verify-signatures",
      "--log-calls",
      "--block-secrets"
    ],
    "env": [
      {
        "name": "MCP_GATEWAY_AUTH_TOKEN",
        "fromRunToken": true
      },
      {
        "name": "HOME",
        "value": "/root"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOWED_PATHS",
        "value": "@@RUN_WORKSPACE@@:@@RUN_OUT@@:@@RUN_CFG@@:@@RUN_INPUTS@@:@@RUN_INPUTS_TEXT@@:@@RUN_KNOWLEDGE@@"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOW_WRITABLE_PATHS",
        "value": "@@RUN_OUT@@"
      }
    ],
    "mounts": [
      {
        "source": "@@RUN_CFG@@/gateway",
        "target": "/root/.docker/mcp/catalogs",
        "readOnly": true
      },
      {
        "source": "/var/run/docker.sock",
        "target": "/var/run/docker.sock"
      }
    ],
    "servers": [
      "agentry-tools"
    ]
  },
  "harness": {
    "adapter": "docker-agent",
    "model": "anthropic/claude-sonnet-4-5",
    "agent": {
      "image": "ghcr.io/blaktron/agentry-docker-agent:1.128.0",
      "argv": [
        "run",
        "--exec",
        "--json",
        "--safety",
        "autonomous",
        "/plan/agent.yaml",
        "-"
      ],
      "env": [
        {
          "name": "MCP_GATEWAY_TOKEN",
          "fromRunToken": true
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "fromHostEnv": "ANTHROPIC_API_KEY",
          "expectedKind": {
            "provider": "anthropic",
            "kind": "api"
          }
        },
        {
          "name": "HTTPS_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "HTTP_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "NO_PROXY",
          "value": "gateway,localhost,127.0.0.1"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "mounts": [
        {
          "source": "@@RUN_CFG@@/harness",
          "target": "/plan",
          "readOnly": true
        }
      ],
      "stdinTask": true,
      "readOnlyRoot": true,
      "tmpfs": [
        "/tmp:mode=1777",
        "/work:mode=1777",
        "/home/docker-agent:mode=1777"
      ]
    },
    "resultKind": "text"
  },
  "proxy": {
    "image": "agentry-runner:test",
    "allow": [
      "api.anthropic.com:443"
    ]
  },
  "budgets": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "output": {},
  "files": {
    "gateway/catalog.yaml": "302d165fc42fca1ae946f1de4819f93e3560e585d5e5369a964ee94febff2df3",
    "gateway/config.yaml": "6ae322f43ef620e4ad682078c22e8a24b8aa6e96de990ad664a91cc53733197c",
    "gateway/registry.yaml": "e5062e24456af9287a9376e986c8b29c6bf9f3802904ce0aa9852244b6ebc11d",
    "gateway/tools.yaml": "0798fb254b6297bd83a8b5a16ccfc544d034bd4be73c4389cf9095ee1740db18",
    "gateway/toolspec.json": "144936ab277a6620348b89d4a84211b363abc2803030b13e994b5b568968e201",
    "harness/agent.yaml": "9e5e0133155bed1875dfd68c3692ff9f06a92ae37d8ab3ff071bbf99ee2fff60"
  }
}
