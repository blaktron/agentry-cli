{
  "planVersion": "2",
  "ref": "demo/pure-text@1.0.0",
  "digest": "sha256:0123456789abcdef",
  "source": "local",
  "modes": [
    "autonomous"
  ],
  "mode": "autonomous",
  "summary": "A pure text agent",
  "policySha256": "fixedpolicysha",
  "instruction": {
    "sourcePath": "AGENT.md",
    "sha256": "e0311a3e1205bed8a43e7169f060deebb818328744b286eb1224667cb0c97aa9",
    "bodySha256": "ea04f9c2aced19c2b7daccfaf1beb2b5fd5e4301a18ecd1a922bf738ffd87b9a"
  },
  "capabilities": {
    "egressMode": "none",
    "fsReadMode": "none",
    "fsWriteMode": "none",
    "scratch": true
  },
  "tools": [
    "list_inputs",
    "read_input",
    "search_inputs",
    "scratch_list",
    "scratch_read",
    "scratch_write",
    "write_report"
  ],
  "enforcement": {
    "agentContainer": "internal-only run network; reachable endpoints: gateway:8811 (Bearer auth) and llm-proxy:3128 (CONNECT allowlist: api.anthropic.com:443); no workspace, output, or docker-socket mounts; model API key present by necessity",
    "exec": "no exec: run_command tool not exposed; harness built-in shell toolsets never enabled",
    "filesystem": "read none; write none — enforced by the tools-container mount table (ro/rw, per-path binds) plus server-side grant checks; on Linux the run's docker filter mounts the tools container's /tmp as a 256 MiB tmpfs and the tools server refuses to serve without it; under Docker Desktop (macOS, Windows), which runs no filter, it is the container's own layer, unbounded",
    "model.apiKey": "$ANTHROPIC_API_KEY from the host environment, injected into the agent container (or the host harness process) only",
    "network": "no egress: tools container runs with networking disabled (disableNetwork); no fetch tool exposed",
    "scratch": "the runner's grant, not the contract's: scratch_list, scratch_read and scratch_write over the scratch folder /scratch on the tools container only, empty at the start, never copied to the output folder, and removed with the container; on Linux a 256 MiB tmpfs the run's docker filter mounts, under Docker Desktop a folder in the container's own layer, unbounded",
    "secrets": "none declared"
  },
  "gateway": {
    "image": "ghcr.io/blaktron/agentry-mcp-gateway:v0.43.3",
    "args": [
      "--transport",
      "streaming",
      "--port",
      "8811",
      "--servers",
      "agentry-tools",
      "--catalog",
      "/root/.docker/mcp/catalogs/catalog.yaml",
      "--registry",
      "/root/.docker/mcp/catalogs/registry.yaml",
      "--config",
      "/root/.docker/mcp/catalogs/config.yaml",
      "--tools-config",
      "/root/.docker/mcp/catalogs/tools.yaml",
      "--secrets",
      "/root/.docker/mcp/catalogs/secrets.env",
      "--block-network",
      "--verify-signatures",
      "--log-calls",
      "--block-secrets"
    ],
    "env": [
      {
        "name": "MCP_GATEWAY_AUTH_TOKEN",
        "fromRunToken": true
      },
      {
        "name": "HOME",
        "value": "/root"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOWED_PATHS",
        "value": "@@RUN_WORKSPACE@@:@@RUN_OUT@@:@@RUN_CFG@@:@@RUN_INPUTS@@:@@RUN_INPUTS_TEXT@@:@@RUN_KNOWLEDGE@@"
      },
      {
        "name": "MCP_GATEWAY_DOCKER_BIND_ALLOW_WRITABLE_PATHS",
        "value": "@@RUN_OUT@@"
      }
    ],
    "mounts": [
      {
        "source": "@@RUN_CFG@@/gateway",
        "target": "/root/.docker/mcp/catalogs",
        "readOnly": true
      },
      {
        "source": "/var/run/docker.sock",
        "target": "/var/run/docker.sock"
      }
    ],
    "servers": [
      "agentry-tools"
    ]
  },
  "harness": {
    "adapter": "docker-agent",
    "model": "anthropic/claude-sonnet-4-5",
    "agent": {
      "image": "ghcr.io/blaktron/agentry-docker-agent:1.128.0",
      "argv": [
        "run",
        "--exec",
        "--json",
        "--safety",
        "autonomous",
        "/plan/agent.yaml",
        "-"
      ],
      "env": [
        {
          "name": "MCP_GATEWAY_TOKEN",
          "fromRunToken": true
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "fromHostEnv": "ANTHROPIC_API_KEY",
          "expectedKind": {
            "provider": "anthropic",
            "kind": "api"
          }
        },
        {
          "name": "HTTPS_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "HTTP_PROXY",
          "value": "http://llm-proxy:3128"
        },
        {
          "name": "NO_PROXY",
          "value": "gateway,localhost,127.0.0.1"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "mounts": [
        {
          "source": "@@RUN_CFG@@/harness",
          "target": "/plan",
          "readOnly": true
        }
      ],
      "stdinTask": true,
      "readOnlyRoot": true,
      "tmpfs": [
        "/tmp:mode=1777",
        "/work:mode=1777",
        "/home/docker-agent:mode=1777"
      ]
    },
    "resultKind": "text"
  },
  "proxy": {
    "image": "agentry-runner:test",
    "allow": [
      "api.anthropic.com:443"
    ]
  },
  "budgets": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "output": {},
