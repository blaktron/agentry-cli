{
  "version": 2,
  "model": {
    "api": "chat-completions",
    "name": "Qwen3.6-35B-A3B",
    "baseUrl": "http://agentry-host.internal:1234/v1",
    "keyEnv": "AGENTRY_MODEL_KEY",
    "maxOutputTokens": 16384,
    "contextWindow": 65536,
    "sampling": {
      "temperature": 1,
      "topP": 0.95,
      "topK": 20,
      "presencePenalty": 1.5
    },
    "extraBody": {
      "chat_template_kwargs": {
        "enable_thinking": true,
        "preserve_thinking": true
      }
    },
    "replayReasoning": true
  },
  "system": "You are an agent.",
  "gateway": {
    "url": "http://gateway:8811/mcp",
    "tokenEnv": "MCP_GATEWAY_TOKEN"
  },
  "sessionDir": "/session",
  "results": {
    "maxBytes": 16384
  },
  "scrub": {
    "unchanged": [
      "read_input",
      "search_inputs"
    ]
  },
  "loop": {
    "repeats": 5,
    "cycleRepeats": 3,
    "maxPeriod": 4
  },
  "lengthRecoveries": 2,
  "coldClear": {
    "afterSeconds": 3600,
    "keepTurns": 2,
    "keepBrowser": 2,
    "minBytes": 4096
  },
  "compaction": {
    "threshold": 0.7,
    "checkpoint": "Keep, under these headings: the task, in the words the person used; the checklist, every step with its status, copied from the latest checklist result above; done, in progress, and blocked with why; the next step; the files, paths and identifiers in play; the constraints the task set and the approaches that failed.",
    "notes": "checklist.md in your scratch folder, which the checklist tool reads"
  },
  "retry": {
    "attempts": 3,
    "baseSeconds": 2,
    "maxSeconds": 60,
    "idleSeconds": 1800
  }
}
