{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Examiner's own reading of a QuickAgent",
  "description": "The Examiner's last message: what its model found reading the package for secrets, scripts against the declared capabilities and text aimed at the examination. The application reports it beside the registry's rules and AI Review, and never counts it in the expected outcome.",
  "type": "object",
  "required": [
    "summary",
    "findings",
    "notRead"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Two to four sentences: what was read and what was found."
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "file",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "secret",
              "script",
              "instruction",
              "other"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "notRead": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "file",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "why": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
