# What the release workflow bakes into every CLI binary it builds and what it
# expects of the Windows and macOS signatures. Not a secret: a reviewable,
# committed statement.
#
# The registry a downloaded binary talks to when the person configures
# nothing, one per channel. This file is the same on main and dev;
# scripts/release-registry.sh picks the line by the branch the release is cut
# from: a commit that has been the head of main bakes production's, one that
# has been the head of dev bakes dev's. Each site's download page refuses a
# build that bakes the other's.
AGENTRY_REGISTRY_PRODUCTION=https://secureagentry.net
AGENTRY_REGISTRY_DEV=https://dev.secureagentry.net
# The CN the Windows signature must carry: the name Azure Artifact Signing
# validated. scripts/check-windows-binary.sh refuses a release signed by any
# other name; the root it chains to is every Artifact Signing customer's, so
# the name is what makes the signature ours.
AGENTRY_WINDOWS_SIGNING_CN="Chris Dupres"
# The macOS Developer ID identity and its Team ID. Public: both are in every
# signature. scripts/sign-darwin.sh refuses a signature that carries any
# other identity or team.
APPLE_SIGNING_IDENTITY="Developer ID Application: Chris Dupres (5K7DTJ5AA5)"
APPLE_TEAM_ID=5K7DTJ5AA5
